@startuml
skinparam backgroundcolor #FFFFFF
skinparam classAttributeIconSize 0
title Patrones Observer, Factory, Strategy y Adapter - US14, US31, US34 (Luciano Moscoso)

package "shared/events" {
  class TripEventBus <<Sujeto>> {
    - observers : Map<string, Observador[]>
    + subscribe(event : string, name : string, handler : Function) : void
    + publish(event : string, payload : Object) : void
    + countObservers(event : string) : number
  }
  enum TRIP_EVENTS {
    ROUTE_PUBLISHED = "ruta_publicada"
    BOOKING_CREATED = "reserva_creada"
    ROUTE_CANCELLED = "ruta_cancelada"
    ROUTE_UPDATED = "ruta_actualizada" (US33, Camila)
  }
  class registerTripSubscribers <<función>> {
    + registerTripSubscribers(bus) : TripEventBus
  }
}

package "shared/persistence" {
  class JsonDataSource <<Singleton>> {
    - {static} instanciaUnica : JsonDataSource
    + {static} getInstancia() : JsonDataSource
    + leerColeccion(nombre) : Array
    + escribirColeccion(nombre, items) : boolean
  }
  class createJsonStore <<Adapter>> {
    + read() : Array
    + write(items) : boolean
  }
}

package "trips" {
  class routeController <<controlador>> {
    + publishRoute(req, res)
    + joinRoute(req, res)
    + cancelPublishedRoute(req, res)
  }
  class reliabilitySubscriber <<Observador>> {
    + registerReliabilityObserver(bus) : void
  }
  class driverReliabilityModel {
    + LATE_CANCELLATION_MINUTES : number = 15
    + addStrike(data) : Object
  }
}

package "notifications" {
  class notificationSubscriber <<Observador>> {
    + registerNotificationObserver(bus) : void
  }
  class NotificationFactory <<Factory>> {
    - creators : Map<tipo, Function>
    + crear(type : string, data : Object) : Notificacion
  }
  class routeMatchingService <<Facade>> {
    - CRITERIOS_BASE : CriterioCoincidencia[]
    - CRITERIOS_NOTIFICACION : CriterioCoincidencia[]
    + routeMatchesAlert(route, alert, criterios) : boolean
    + notifyMatchingAlertsForRoute(route) : number
    + notifyExistingRoutesForAlert(alert, routes) : Array
  }
  abstract class CriterioCoincidencia <<Strategy>> {
    + nombre : string
    + {abstract} cumple(route, alert) : boolean
  }
  class CriterioAlertaActiva
  class CriterioNoEsPropiaRuta
  class CriterioCoordenadasValidas
  class CriterioDistancia {
    + campo : string
    + radioKm : number = 2
  }
  class CriterioHorario
  class CriterioPreferenciaCuenta {
    + puedeNotificar : Function
  }
  class notificationModel {
    + NOTIFICATION_TYPES
    + PRIORITY
    + createNotification(item)
    + createNotifications(items)
    + addRouteMatchNotifications(matches)
  }
}

routeController ..> TripEventBus : publish(evento)
routeController ..> TRIP_EVENTS
TripEventBus "1" o-- "0..*" notificationSubscriber : notifica >
TripEventBus "1" o-- "0..*" reliabilitySubscriber : notifica >
registerTripSubscribers ..> notificationSubscriber : registra
registerTripSubscribers ..> reliabilitySubscriber : registra
notificationSubscriber ..> NotificationFactory : crear()
notificationSubscriber ..> notificationModel : guarda avisos
notificationSubscriber ..> routeMatchingService : coincidencias US31
routeMatchingService ..> NotificationFactory : crear(ROUTE_MATCH)
reliabilitySubscriber ..> driverReliabilityModel : addStrike()
NotificationFactory ..> notificationModel : usa tipos y prioridades
routeMatchingService "1" o-- "1..*" CriterioCoincidencia : aplica todos >
CriterioCoincidencia <|-- CriterioAlertaActiva
CriterioCoincidencia <|-- CriterioNoEsPropiaRuta
CriterioCoincidencia <|-- CriterioCoordenadasValidas
CriterioCoincidencia <|-- CriterioDistancia
CriterioCoincidencia <|-- CriterioHorario
CriterioCoincidencia <|-- CriterioPreferenciaCuenta
createJsonStore ..> JsonDataSource : adapta read/write a leerColeccion/escribirColeccion
notificationModel ..> createJsonStore : persistencia
driverReliabilityModel ..> createJsonStore : persistencia
@enduml
